diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 274af9b..444e7bb 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -959,6 +959,17 @@ private:
                 // note: for sleeping == false, event is emitted by load_model()
             }
             SRV_INF("%s", "server is entering sleeping state\n");
+            // keep the conversation state across sleep: move each slot's state (tokens, checkpoints, KV/recurrent data)
+            // into the host-memory prompt cache, which survives destroy(), so resuming does not re-process the prompt
+            if (prompt_cache) {
+                for (auto & slot : slots) {
+                    if (slot.prompt.n_tokens() > 0) {
+                        slot.prompt_save(*prompt_cache);
+                    }
+                    slot.prompt.clear();
+                }
+                prompt_cache->update();
+            }
             destroy();
         } else {
             SRV_INF("%s", "server is exiting sleeping state\n");
@@ -1356,7 +1367,10 @@ private:
             }
             SRV_TRC("%s", "use `--cache-ram 0` to disable the prompt cache\n");
 
-            prompt_cache = std::make_unique<server_prompt_cache>(params_base.cache_ram_mib, n_ctx);
+            // on resume from sleep, keep the existing cache: it holds the states saved before sleeping
+            if (!is_resume || !prompt_cache) {
+                prompt_cache = std::make_unique<server_prompt_cache>(params_base.cache_ram_mib, n_ctx);
+            }
         } else {
             SRV_TRC("%s", "prompt cache is disabled - use `--cache-ram N` to enable it\n");
         }
